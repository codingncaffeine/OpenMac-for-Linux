<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpenMac.Gui.MainWindow"
        Title="OpenMac" Height="560" Width="760" MinWidth="360" MinHeight="300"
        DragDrop.AllowDrop="True">
    <DockPanel>
        <Menu x:Name="MainMenu" DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="Open ROM…" InputGesture="Ctrl+O" Click="OpenRom_Click" />
                <MenuItem x:Name="RecentMenu" Header="Open Recent" />
                <Separator />
                <MenuItem x:Name="WriteProtectItem" Header="Write-Protect Floppies"
                          ToggleType="CheckBox" Click="WriteProtectFloppies_Click"
                          ToolTip.Tip="Locks the tab on every floppy, the way a locked disk is locked. Turn this off to let the Mac save changes back into the image file it came from." />
                <MenuItem Header="Insert Floppy in Internal Drive…" Click="InsertFloppy_Click" />
                <MenuItem x:Name="EjectFloppyItem" Header="Eject Floppy from Internal Drive"
                          Click="EjectFloppy_Click" />
                <Separator />
                <MenuItem x:Name="ExternalDriveItem" Header="External Drive Connected"
                          ToggleType="CheckBox" Click="ExternalDrive_Click" />
                <MenuItem Header="Insert Floppy in External Drive…" Click="InsertExternalFloppy_Click" />
                <MenuItem x:Name="EjectFloppy2Item" Header="Eject Floppy from External Drive"
                          Click="EjectExternalFloppy_Click" />
                <Separator />
                <MenuItem Header="Attach Hard Disk…" Click="AttachHardDisk_Click" />
                <MenuItem Header="Create Hard Disk…" Click="CreateHardDisk_Click" />
                <MenuItem x:Name="DetachHdItem" Header="Detach Hard Disk" Click="DetachHardDisk_Click" />
                <Separator />
                <MenuItem x:Name="CdDriveItem" Header="CD-ROM Drive Connected"
                          ToggleType="CheckBox" Click="CdDrive_Click"
                          ToolTip.Tip="Puts an AppleCD SC-class drive on the SCSI bus. The Mac finds it during its startup bus scan, so connecting one wants a restart; discs can then go in and out any time." />
                <MenuItem Header="Insert CD Image…" Click="InsertCd_Click" />
                <MenuItem x:Name="EjectCdItem" Header="Eject CD" Click="EjectCd_Click" />
                <Separator />
                <MenuItem Header="Drop Box"
                          ToolTip.Tip="A folder on this computer kept on the Mac's desktop as a real disk. Drop files on the OpenMac window and they appear in it; what the Mac saves there comes back to the folder.">
                    <MenuItem x:Name="DropBoxEnabledItem" Header="Keep Drop Box on the Desktop"
                              ToggleType="CheckBox" Click="DropBoxEnabled_Click"
                              ToolTip.Tip="Puts the folder on the SCSI bus for the whole session. Its driver is loaded by the Mac's startup scan, so turning this on wants a restart the first time." />
                    <MenuItem x:Name="DropBoxFolderItem" Header="Choose Folder…"
                              Click="DropBoxChooseFolder_Click" />
                    <MenuItem x:Name="DropBoxOpenItem" Header="Open Folder"
                              Click="DropBoxOpenFolder_Click" />
                    <Separator />
                    <MenuItem x:Name="DropBoxRepublishItem" Header="Refresh Now"
                              Click="DropBoxRepublish_Click"
                              ToolTip.Tip="Rebuild the disk from the folder. Use this after adding files to the folder in the file manager rather than by dropping them on the window." />
                </MenuItem>
                <MenuItem Header="Open Host Folder as Disk…" Click="OpenFolderDisk_Click"
                          ToolTip.Tip="Builds a real HFS disk from a folder on this computer and puts it on the SCSI bus. Changes the Mac makes come back to the folder when the disk is closed, the machine restarts, or OpenMac quits." />
                <MenuItem x:Name="CloseFolderDiskItem" Header="Close Folder Disk"
                          Click="CloseFolderDisk_Click" />
                <Separator />
                <MenuItem Header="Exit" InputGesture="Alt+F4" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Machine">
                <MenuItem Header="Model">
                    <MenuItem x:Name="ModelClassicItem" Header="Macintosh Classic"
                              ToggleType="Radio" GroupName="model" Click="ModelClassic_Click" />
                    <MenuItem x:Name="ModelIifxItem" Header="Macintosh IIfx"
                              ToggleType="Radio" GroupName="model" Click="ModelIifx_Click"
                              ToolTip.Tip="68030/68882 @ 40 MHz with OSS, two I/O processors and Macintosh II NuBus video. Needs the 512 KB IIfx ROM; each model remembers its own ROM, RAM and SCSI disk." />
                    <MenuItem x:Name="ModelQuadraItem" Header="Macintosh Quadra 650"
                              ToggleType="Radio" GroupName="model" Click="ModelQuadra_Click"
                              ToolTip.Tip="68040 @ 33 MHz with color DAFB video. Needs the 1 MB Quadra 650 family ROM and boots from a SCSI hard disk; each model remembers its own ROM and disk." />
                </MenuItem>
                <MenuItem x:Name="MonitorMenu" Header="Monitor"
                          ToolTip.Tip="Which display is plugged into the video port. An Apple monitor of this era runs one resolution, so choosing the monitor chooses the resolution. The ROM senses it at startup, so the machine restarts." />
                <MenuItem x:Name="IifxVideoRomItem" Header="8•24 GC Card ROM…"
                          Click="IifxVideoRom_Click"
                          ToolTip.Tip="Choose the declaration ROM from an Apple Macintosh Display Card 8•24 GC. The IIfx restarts with the genuine slot-$9 card; OpenMac does not distribute this ROM." />
                <Separator />
                <MenuItem Header="Reset" InputGesture="Ctrl+R" Click="Reset_Click" />
                <Separator />
                <MenuItem x:Name="Mem1Item" Header="1 MB RAM" Tag="1" ToggleType="Radio" GroupName="ram" Click="Memory_Click" />
                <MenuItem x:Name="Mem2Item" Header="2 MB RAM" Tag="2" ToggleType="Radio" GroupName="ram" Click="Memory_Click" />
                <MenuItem x:Name="Mem4Item" Header="4 MB RAM" Tag="4" ToggleType="Radio" GroupName="ram" Click="Memory_Click" />
                <MenuItem x:Name="MemFx4Item" Header="4 MB RAM" Tag="4" ToggleType="Radio" GroupName="ram" Click="MemoryIifx_Click" />
                <MenuItem x:Name="MemQ8Item" Header="8 MB RAM" Tag="8" ToggleType="Radio" GroupName="ram" Click="MemoryLarge_Click" />
                <MenuItem x:Name="MemQ16Item" Header="16 MB RAM" Tag="16" ToggleType="Radio" GroupName="ram" Click="MemoryLarge_Click" />
                <MenuItem x:Name="MemFx20Item" Header="20 MB RAM" Tag="20" ToggleType="Radio" GroupName="ram" Click="MemoryIifx_Click" />
                <MenuItem x:Name="MemQ32Item" Header="32 MB RAM" Tag="32" ToggleType="Radio" GroupName="ram" Click="MemoryLarge_Click" />
                <MenuItem x:Name="MemQ64Item" Header="64 MB RAM" Tag="64" ToggleType="Radio" GroupName="ram" Click="MemoryLarge_Click" />
                <MenuItem x:Name="MemFx68Item" Header="68 MB RAM" Tag="68" ToggleType="Radio" GroupName="ram" Click="MemoryIifx_Click" />
                <MenuItem x:Name="MemFx80Item" Header="80 MB RAM" Tag="80" ToggleType="Radio" GroupName="ram" Click="MemoryIifx_Click" />
                <MenuItem x:Name="MemQ128Item" Header="128 MB RAM" Tag="128" ToggleType="Radio" GroupName="ram" Click="MemoryLarge_Click" />
                <MenuItem x:Name="MemQ136Item" Header="136 MB RAM (max)" Tag="136" ToggleType="Radio" GroupName="ram" Click="MemoryLarge_Click" />
                <Separator />
                <MenuItem x:Name="BootRomDiskItem" Header="Boot from ROM Disk (Cmd-Opt-X-O)"
                          ToggleType="CheckBox" Click="BootRomDisk_Click" />
                <MenuItem x:Name="BootExtensionsOffItem" Header="Boot with Extensions Off (Shift)"
                          ToggleType="CheckBox" Click="BootExtensionsOff_Click"
                          ToolTip.Tip="Holds the Shift key down inside the Mac at the start of every boot, so System 6/7 loads no extensions — without holding the real key, which can trip the desktop's sticky-keys accessibility setting. Applies until unchecked; restarts the machine when toggled." />
                <Separator />
                <MenuItem x:Name="NetworkingItem" Header="Networking (DaynaPORT at SCSI 4)"
                          ToggleType="CheckBox" Click="Networking_Click"
                          ToolTip.Tip="Puts a DaynaPORT SCSI/Link Ethernet adapter on the bus, backed by user-mode NAT — no drivers or root access on this computer. Inside the Mac, install the Dayna SCSI/Link driver and MacTCP, set MacTCP to BOOTP (or manually to 10.0.2.15, router 10.0.2.2, DNS 10.0.2.3), and restart." />
            </MenuItem>
            <MenuItem Header="_Key Combos">
                <MenuItem Tag="cmd+q" Click="SendCombo_Click">
                    <MenuItem.Header><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Quit Application" /><TextBlock Grid.Column="1" Classes="gesture" Text="⌘Q" /></Grid></MenuItem.Header>
                </MenuItem>
                <MenuItem Tag="cmd+w" Click="SendCombo_Click">
                    <MenuItem.Header><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Close Window" /><TextBlock Grid.Column="1" Classes="gesture" Text="⌘W" /></Grid></MenuItem.Header>
                </MenuItem>
                <MenuItem Tag="cmd+opt+esc" Click="SendCombo_Click">
                    <MenuItem.Header><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Force Quit" /><TextBlock Grid.Column="1" Classes="gesture" Text="⌘⌥Esc" /></Grid></MenuItem.Header>
                </MenuItem>
                <MenuItem Tag="cmd+period" Click="SendCombo_Click">
                    <MenuItem.Header><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Cancel / Stop" /><TextBlock Grid.Column="1" Classes="gesture" Text="⌘." /></Grid></MenuItem.Header>
                </MenuItem>
                <Separator />
                <MenuItem Tag="cmd+n" Click="SendCombo_Click">
                    <MenuItem.Header><Grid ColumnDefinitions="*,Auto"><TextBlock Text="New" /><TextBlock Grid.Column="1" Classes="gesture" Text="⌘N" /></Grid></MenuItem.Header>
                </MenuItem>
                <MenuItem Tag="cmd+o" Click="SendCombo_Click">
                    <MenuItem.Header><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Open" /><TextBlock Grid.Column="1" Classes="gesture" Text="⌘O" /></Grid></MenuItem.Header>
                </MenuItem>
                <MenuItem Tag="cmd+s" Click="SendCombo_Click">
                    <MenuItem.Header><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Save" /><TextBlock Grid.Column="1" Classes="gesture" Text="⌘S" /></Grid></MenuItem.Header>
                </MenuItem>
                <MenuItem Tag="cmd+p" Click="SendCombo_Click">
                    <MenuItem.Header><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Print" /><TextBlock Grid.Column="1" Classes="gesture" Text="⌘P" /></Grid></MenuItem.Header>
                </MenuItem>
                <Separator />
                <MenuItem Tag="cmd+z" Click="SendCombo_Click">
                    <MenuItem.Header><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Undo" /><TextBlock Grid.Column="1" Classes="gesture" Text="⌘Z" /></Grid></MenuItem.Header>
                </MenuItem>
                <MenuItem Tag="cmd+x" Click="SendCombo_Click">
                    <MenuItem.Header><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Cut" /><TextBlock Grid.Column="1" Classes="gesture" Text="⌘X" /></Grid></MenuItem.Header>
                </MenuItem>
                <MenuItem Tag="cmd+c" Click="SendCombo_Click">
                    <MenuItem.Header><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Copy" /><TextBlock Grid.Column="1" Classes="gesture" Text="⌘C" /></Grid></MenuItem.Header>
                </MenuItem>
                <MenuItem Tag="cmd+v" Click="SendCombo_Click">
                    <MenuItem.Header><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Paste" /><TextBlock Grid.Column="1" Classes="gesture" Text="⌘V" /></Grid></MenuItem.Header>
                </MenuItem>
                <MenuItem Tag="cmd+a" Click="SendCombo_Click">
                    <MenuItem.Header><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Select All" /><TextBlock Grid.Column="1" Classes="gesture" Text="⌘A" /></Grid></MenuItem.Header>
                </MenuItem>
                <Separator />
                <MenuItem Tag="cmd+shift+1" Click="SendCombo_Click">
                    <MenuItem.Header><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Eject Internal Floppy" /><TextBlock Grid.Column="1" Classes="gesture" Text="⌘⇧1" /></Grid></MenuItem.Header>
                </MenuItem>
                <MenuItem Tag="cmd+shift+2" Click="SendCombo_Click">
                    <MenuItem.Header><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Eject External Floppy" /><TextBlock Grid.Column="1" Classes="gesture" Text="⌘⇧2" /></Grid></MenuItem.Header>
                </MenuItem>
                <MenuItem Tag="cmd+shift+3" Click="SendCombo_Click">
                    <MenuItem.Header><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Screen Snapshot to Disk" /><TextBlock Grid.Column="1" Classes="gesture" Text="⌘⇧3" /></Grid></MenuItem.Header>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem x:Name="ScaleFitItem" Header="Fit Window" Tag="0" ToggleType="Radio" GroupName="scale" Click="Scale_Click" />
                <MenuItem x:Name="Scale1Item" Header="1×  (512 × 342)" Tag="1" ToggleType="Radio" GroupName="scale" Click="Scale_Click" />
                <MenuItem x:Name="Scale2Item" Header="2×  (1024 × 684)" Tag="2" ToggleType="Radio" GroupName="scale" Click="Scale_Click" />
                <MenuItem x:Name="Scale3Item" Header="3×  (1536 × 1026)" Tag="3" ToggleType="Radio" GroupName="scale" Click="Scale_Click" />
                <Separator />
                <MenuItem Header="Fullscreen" InputGesture="F11" Click="Fullscreen_Click" />
                <MenuItem Header="Debugger…" Click="Debugger_Click" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Capture Diagnostics…" Click="CaptureDiagnostics_Click"
                          ToolTip.Tip="Save a snapshot of what the machine is doing — take it while it is misbehaving." />
                <Separator />
                <MenuItem Header="About OpenMac" Click="About_Click" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,3">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StatusState" Text="Stopped" Classes="secondary" />
                    <TextBlock Text="   " />
                    <TextBlock x:Name="StatusMachine" Text="No ROM loaded" Classes="secondary" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="StatusSpeed" Text="" Classes="secondary"
                               ToolTip.Tip="Emulation speed over the last second: guest frames run against real time. 100% is a real machine." />
                    <TextBlock x:Name="StatusBackend" Text="core: stub" Classes="secondary" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="ScreenHost" Background="{DynamicResource Letterbox}">
            <Viewbox Stretch="Uniform" StretchDirection="Both">
                <Image x:Name="ScreenImage" Width="512" Height="342" Focusable="True"
                       RenderOptions.BitmapInterpolationMode="None" />
            </Viewbox>
            <Border x:Name="Overlay" Background="#D0121214">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="OpenMac" FontSize="42" FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <Border Width="66" Height="3" Background="{DynamicResource Accent}"
                            Margin="0,12" HorizontalAlignment="Center" />
                    <TextBlock Text="Classic · IIfx · Quadra 650" FontSize="14" Classes="secondary"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="File  ▸  Open ROM  to begin" Margin="0,16,0,0" Classes="secondary"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
